{
  "name": "s12-api-ferreteria-drizzle",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de productos de ferretería con Express, PostgreSQL, TypeScript y migraciones Drizzle ORM",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:evolve": "node scripts/activar-evolucion.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
